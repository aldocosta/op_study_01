{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": ".NET: ApresentacaoDotNet",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/ApresentacaoDotNet.csproj"
    },
    {
      "name": ".NET: Launch DLL (coreclr)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/ApresentacaoDotNet.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
